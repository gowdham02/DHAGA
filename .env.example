# Required for live LangChain analysis. Never commit the real value.
LLM_API_KEY=
# Alternative supported name for official OpenAI deployments only.
# OPENAI_API_KEY=

# Two different OpenRouter models: economical classifier and stronger evaluator.
# Keep the provider prefix and confirm model availability in your account.
LLM_PROVIDER=openrouter
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_APP_NAME=DHAGA FITLENS
# Optional attribution URL for an internal deployment.
# OPENROUTER_SITE_URL=https://your-internal-app.example
CLASSIFIER_MODEL=openai/gpt-4.1-mini
EVALUATOR_MODEL=openai/gpt-4.1
CLASSIFIER_TEMPERATURE=0
EVALUATOR_TEMPERATURE=0

# Optional USD-per-1M-token rates. Leave blank to hide cost estimate.
CLASSIFIER_INPUT_COST_PER_MILLION=
CLASSIFIER_OUTPUT_COST_PER_MILLION=
EVALUATOR_INPUT_COST_PER_MILLION=
EVALUATOR_OUTPUT_COST_PER_MILLION=
